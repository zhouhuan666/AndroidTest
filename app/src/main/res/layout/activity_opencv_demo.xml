<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题和版本信息 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OpenCV图像处理演示"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_opencv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OpenCV版本信息"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- 图像加载区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_load_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="加载图像"
                android:background="@drawable/btn_primary"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_image_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="图像信息将显示在这里"
                android:textSize="12sp"
                android:textColor="#666666"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- 图像显示区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- 原始图像 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="原始图像"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <ImageView
                    android:id="@+id/iv_original"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#FFFFFF"
                    android:scaleType="centerInside"
                    android:contentDescription="原始图像" />

            </LinearLayout>

            <!-- 处理后图像 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="处理结果"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <ImageView
                    android:id="@+id/iv_processed"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#FFFFFF"
                    android:scaleType="centerInside"
                    android:contentDescription="处理后图像" />

            </LinearLayout>

        </LinearLayout>

        <!-- 处理结果信息 -->
        <TextView
            android:id="@+id/tv_processing_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请选择图像处理操作"
            android:textSize="14sp"
            android:textColor="#666666"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- 基础处理按钮 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="基础图像处理"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_grayscale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="灰度转换"
                android:background="@drawable/btn_secondary"
                android:textColor="@android:color/white"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_blur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="高斯模糊"
                android:background="@drawable/btn_secondary"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_edges"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="边缘检测"
                android:background="@drawable/btn_secondary"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_hist_eq"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="直方图均衡"
                android:background="@drawable/btn_secondary"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- 参数调节区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="参数调节"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <!-- 模糊核大小 -->
        <TextView
            android:id="@+id/tv_blur_kernel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="模糊核大小: 9"
            android:textSize="14sp"
            android:textColor="#666666" />

        <SeekBar
            android:id="@+id/seek_blur_kernel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- 边缘检测阈值1 -->
        <TextView
            android:id="@+id/tv_edge_threshold1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="边缘阈值1: 50"
            android:textSize="14sp"
            android:textColor="#666666" />

        <SeekBar
            android:id="@+id/seek_edge_threshold1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- 边缘检测阈值2 -->
        <TextView
            android:id="@+id/tv_edge_threshold2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="边缘阈值2: 150"
            android:textSize="14sp"
            android:textColor="#666666" />

        <SeekBar
            android:id="@+id/seek_edge_threshold2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- 高级处理按钮 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="高级图像处理"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_color_seg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="颜色分割"
                android:background="@drawable/btn_accent"
                android:textColor="@android:color/white"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_morphology"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="形态学处理"
                android:background="@drawable/btn_accent"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_perspective"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="透视变换"
                android:background="@drawable/btn_accent"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_stitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="图像拼接"
                android:background="@drawable/btn_accent"
                android:textColor="@android:color/white"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- 说明文本 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨ 这个演示展示了如何将强大的OpenCV库集成到Android应用中\n📱 通过JNI接口，我们可以充分利用C++的高性能图像处理能力\n🎯 实际项目中，这种集成方式广泛用于计算机视觉、AR/VR、图像识别等领域"
            android:textSize="12sp"
            android:textColor="#666666"
            android:background="#E3F2FD"
            android:padding="12dp"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>























































